# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key, safe for the browser (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Supabase secret key, server only, bypasses row-level security
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Anthropic API key for the agent
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Model the agent uses (Haiku for dev, claude-sonnet-5-5 for the demo)
LLM_MODEL=claude-haiku-5-5

# Tavily API key for the news search tool
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
# User-Agent sent to SEC EDGAR, must include a name and email
SEC_USER_AGENT="Comps Capstone your-name@example.com"

# Stripe secret key (test mode)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Stripe webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Public base URL of the app, used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev/test only: comma-separated emails exempt from usage limits. Leave unset in production.
UNLIMITED_USER_EMAILS=
